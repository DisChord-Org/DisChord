encender bot {
    token "mitoken"
    prefijo "!"
    intenciones [ "Servidores" ]
}

nuevo evento encendido {
    imprimir("[" mas usuario.nombre mas "] Bot Encendido")
}

nuevo comando StringTest {
    descripcion "Test de Strings";

    opciones {
        repetir {
            opcion "texto"
            descripcion "El bot responde con lo que escribas"
            requerido verdadero
        }
    }

    enviar mensaje {
        contenido repetir
    }
}
