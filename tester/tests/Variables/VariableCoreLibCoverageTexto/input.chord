var t tipo texto es s.recortarFinal()
var u tipo texto es s.normalizar()
var v tipo numero es s.buscar("a")
var w tipo numero es s.codigoEn(0)
var x tipo texto es s.subcadena(0, 1)
var z tipo numero es s.comparar("b")
var ab tipo numero es s.longitud
var ac tipo texto es s.coincidir("a")
var ad tipo numero es s.coincidirTodo("a")

