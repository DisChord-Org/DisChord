nuevo comando Punto {
    descripcion "punto"

    opciones {
        x {
            descripcion "x"
            tipo "numero"
            requerido verdadero
        }
        y {
            descripcion "y"
            tipo "numero"
            requerido verdadero
        }
        o {
            descripcion "o"
            tipo "numero"
            requerido verdadero
        }
    }

    consola.imprimir(x)
}
