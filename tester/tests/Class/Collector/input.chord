funcion alPulsarMiId (interaccion, cliente) {
    imprimir("Se ha pulsado el boton con id miid")
}

nuevo comando HolaMundo {
    descripcion "un hola mundo desde DisChord";

    var msg es enviar mensaje {
        embed {
            descripcion "hola"
        }
        boton {
            id "miid"
            etiqueta "mi boton"
            emoji "🔥"
            estilo "azul"
        }
    }

    recolector msg {
        alPulsarId {
            miid alPulsarMiId
        }
    }
}
