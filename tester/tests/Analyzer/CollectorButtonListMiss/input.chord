funcion alPulsar(interaccion, cliente) {
    imprimir("pulsado")
}

nuevo comando Prueba {
    descripcion "prueba"

    var msg es enviar mensaje {
        contenido "hola"
        boton [
            { id "uno" etiqueta "1" estilo "verde" }
            { id "dos" etiqueta "2" estilo "verde" }
        ]
    }

    recolector msg {
        alPulsarId {
            tres alPulsar
        }
    }
}
